+void PlayerMessageProcessor::cheatBilladenResources(PlayerColor player)
+{
+	const auto * playerState = gameHandler->gameState().getPlayerState(player);
+	if(!playerState)
+		return;
+
+	TResources resources;
+	for(const auto & resource : LIBRARY->resourceTypeHandler->getAllObjects())
+	{
+		const int64_t currentAmount = playerState->resources[resource];
+		const int64_t targetAmount = std::min(
+			GameConstants::PLAYER_RESOURCES_CAP,
+			currentAmount * 10);
+		const int64_t increase = std::max<int64_t>(0, targetAmount - currentAmount);
+		resources[resource] = static_cast<TResource>(increase);
+	}
+
+	gameHandler->giveResources(player, resources);
+
+	InfoWindow message;
+	message.player = player;
+	message.type = EInfoWindowMode::AUTO;
+	message.text.appendRawString("BILLADENC4");
+	gameHandler->showInfoDialog(&message);
+}
