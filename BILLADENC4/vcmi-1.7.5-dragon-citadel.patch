+
+static void exportTemplates()
+{
+ JsonNode result;
+ const std::vector<std::pair<std::string, std::string>> specs = {
+  {"town", "dragon-citadel:dragonCitadel"}, {"hero", "dragon-citadel:dragonLord"},
+  {"sign", "object"}, {"mine", "sawmill"}, {"mine", "orePit"}, {"mine", "goldMine"},
+  {"resource", "gold"}, {"resource", "wood"}, {"resource", "ore"},
+  {"monster", "pikeman"}, {"monster", "halberdier"}, {"monster", "archer"},
+  {"monster", "swordsman"}, {"monster", "crusader"}, {"monster", "mage"},
+  {"monster", "monk"}, {"monster", "cavalier"}, {"monster", "champion"},
+  {"monster", "angel"}, {"monster", "archangel"}, {"monster", "blackDragon"},
+  {"mountain", "object"}, {"oakTrees", "object"}, {"pineTrees", "object"}, {"rock", "object"}
+ };
+ for(const auto & [type, sub] : specs)
+ {
+  auto handler = LIBRARY->objtypeh->getHandlerFor("dragon-citadel", type, sub);
+  auto templates = handler->getMostSpecificTemplates(TerrainId(2));
+  if(templates.empty()) templates = handler->getTemplates();
+  require(!templates.empty(), "Missing template: " + type + "/" + sub);
+  templates.front()->writeJson(result[type + "/" + sub]);
+ }
+ const auto * faction = FactionID(FactionID::decode("dragon-citadel:dragonCitadel")).toFaction();
+ for(const auto & [id, building] : faction->town->buildings)
+ {
+  auto key = building->getJsonKey();
+  key = key.substr(key.find(':') + 1);
+  result["buildingIDs"][key].Integer() = id.getNum();
+ }
+ std::ofstream("campaign-templates.json") << result.toString();
+ std::cout << "PASS exported " << specs.size() << " native object templates" << std::endl;
+}
+
+static void validateCampaign()
+{
+ auto campaign = CampaignHandler::getCampaign("MAPS/Smocza_Cytadela.vcmp");
+ require(campaign->scenariosCount() == 8, "Campaign must contain eight scenarios");
+ for(int stage = 0; stage < 8; ++stage)
+ {
+  CampaignScenarioID id(stage);
+  require(campaign->isAvailable(id), "Scenario not available in sequence");
+  if(stage < 7) require(!campaign->isAvailable(CampaignScenarioID(stage + 1)), "Next chapter unlocked too soon");
+  campaign->setCurrentMap(id);
+  StartInfo start;
+  start.mode = EStartMode::CAMPAIGN;
+  start.campState = campaign;
+  start.difficulty = 0;
+  auto header = campaign->getMapHeader(id);
+  for(int p = 0; p < header->players.size(); ++p)
+  {
+   const auto & info = header->players[p];
+   if(!info.canHumanPlay && !info.canComputerPlay) continue;
+   auto & player = start.playerInfos[PlayerColor(p)];
+   player.color = PlayerColor(p);
+   player.name = "Campaign regression";
+   player.connectedPlayerIDs.insert(static_cast<PlayerConnectionID>(p));
+   player.castle = info.defaultCastle();
+   player.hero = info.defaultHero();
+  }
+  CampaignTestServer server;
+  CGameHandler handler(server);
+  server.handler = &handler;
+  Load::ProgressAccumulator progress;
+  handler.init(&start, progress);
+  const auto & map = handler.gs->getMap();
+  require(map.events.size() >= 5, "Missing in-game story events");
+  require(!map.getAllTowns().empty(), "Missing starting town");
+  auto * town = handler.gs->getTown(map.getAllTowns().front());
+  require(town->getFaction()->getJsonKey() == "dragon-citadel:dragonCitadel", "Wrong starting faction");
+  for(int tier = 0; tier < 7; ++tier)
+  {
+   const auto dwelling = BuildingID(BuildingID::DWELL_LVL_1 + tier);
+   require(town->forbiddenBuildings.count(dwelling) == (tier > stage ? 1 : 0), "Incorrect dwelling restriction");
+   if(tier <= stage) require(town->hasBuilt(dwelling), "Unlocked base dwelling must already exist");
+  }
+  require(town->creatures.at(7).second.empty() == (stage < 7), "Level 8 recruitment gate incorrect");
+  require(!handler.gs->checkForVictoryAndLoss(PlayerColor(0)).victory(), "Chapter wins without completing objectives");
+  for(const auto & event : map.events)
+  {
+   require(event.message.toString().size() > 20, "Empty in-game story text");
+   require(event.affectsPlayer(PlayerColor(0), true), "Story event not addressed to human player");
+  }
+  const auto heroes = map.getObjects<CGHeroInstance>();
+  require(heroes.size() == 1, "Expected a single authored campaign hero");
+  const auto * hero = heroes.front();
+  // Test land connectivity after collectible resources and hostile guards are cleared.
+  std::set<int3> reachable{hero->visitablePos()};
+  std::vector<int3> frontier{hero->visitablePos()};
+  for(size_t p = 0; p < frontier.size(); ++p)
+  {
+   for(int dx = -1; dx <= 1; ++dx)
+    for(int dy = -1; dy <= 1; ++dy)
+    {
+     const auto tile = frontier[p] + int3(dx, dy, 0);
+     if(!map.isInTheMap(tile) || reachable.count(tile)) continue;
+     const auto & terrain = map.getTile(tile);
+     if(!terrain.isLand() || (terrain.blocked() && !terrain.visitable())) continue;
+     reachable.insert(tile);
+     frontier.push_back(tile);
+    }
+  }
+  int objectives = 0;
+  for(const auto * object : map.getObjects())
+  {
+   if(object->ID == Obj::TOWN || object->ID == Obj::MINE || object->ID == Obj::MONSTER || object->ID == Obj::SIGN)
+   {
+    require(reachable.count(object->visitablePos()) != 0, "Unreachable objective: " + object->instanceName);
+    ++objectives;
+   }
+  }
+  if(stage < 7)
+  {
+   handler.buildStructure(town->id, BuildingID::GRAIL, true);
+   require(town->creatures.at(7).second.empty(), "Grail bypassed the chapter's level-8 restriction");
+  }
+  // Exercise actual victory predicates with simulated completed battles, not a human playthrough.
+  for(const auto * object : map.getObjects())
+  {
+   if(object->ID == Obj::MINE) handler.setOwner(object, PlayerColor(0));
+   if(object->ID == Obj::MONSTER) handler.removeObject(object, PlayerColor(0));
+  }
+  handler.gs->day = 30;
+  handler.giveResources(PlayerColor(0), ResourceSet() + 1000000);
+  for(const auto townID : map.getAllTowns())
+  {
+   auto * current = handler.gs->getTown(townID);
+   for(const auto & [buildingID, building] : current->getTown()->buildings)
+   {
+    if(current->forbiddenBuildings.count(buildingID)) continue;
+    const auto key = building->getJsonKey();
+    if(key.find("dwellingUp") != std::string::npos || key.find("special6") != std::string::npos)
+    {
+     if(key.find("Lvl4") != std::string::npos)
+     {
+      const auto ruby = key.find("Up3") != std::string::npos || key.find("Up2") != std::string::npos;
+      if(ruby != (current->instanceName == "ruby_outpost")) continue;
+     }
+     handler.buildStructure(townID, buildingID, true);
+    }
+   }
+  }
+  if(stage == 7)
+  {
+   require(!handler.gs->checkForVictoryAndLoss(PlayerColor(0)).victory(), "Finale won without recruiting a final dragon");
+   const auto dragon = CreatureID(CreatureID::decode("dragon-citadel:dcUltimateDragon"));
+   require(handler.insertNewStack(StackLocation(hero->id, SlotID(6)), dragon.toCreature(), 1), "Could not place the finale recruit");
+  }
+  require(handler.gs->checkForVictoryAndLoss(PlayerColor(0)).victory(), "Chapter cannot be won after completing its objectives");
+  handler.removeObject(hero, PlayerColor::NEUTRAL);
+  require(handler.gs->checkForVictoryAndLoss(PlayerColor(0)).loss(), "Losing Billaden must end the chapter in defeat");
+  std::cout << "PASS " << objectives << " reachable objective locations and native victory predicates" << std::endl;
+  std::cout << "PASS chapter " << stage + 1 << ": native campaign start, town, restrictions and " << map.events.size() << " story events" << std::endl;
+  campaign->setCurrentMapAsConquered({});
+ }
+ require(campaign->isCampaignFinished(), "Campaign progression did not finish");
+ std::cout << "PASS all eight maps load and all seven chapter transitions unlock correctly" << std::endl;
+}
+
+int main(int argc, char ** argv)
+{
+ try
+ {
+  LIBRARY = new GameLibrary;
+  LIBRARY->initializeFilesystem(false);
+  LIBRARY->initializeLibrary();
+  if(argc > 1 && std::string(argv[1]) == "--export") exportTemplates();
+  else validateCampaign();
+  return 0;
+ }
+ catch(const std::exception & e) { std::cerr << "FAIL: " << e.what() << std::endl; return 1; }
+}
