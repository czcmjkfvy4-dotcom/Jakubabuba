@@ -0,0 +1,150 @@
+#include "../../server/StdInc.h"
+#include "../../server/CGameHandler.h"
+#include "../../server/IGameServer.h"
+#include "../../server/processors/NewTurnProcessor.h"
+#include "../../lib/GameLibrary.h"
+#include "../../lib/StartInfo.h"
+#include "../../lib/CPlayerState.h"
+#include "../../lib/gameState/CGameState.h"
+#include "../../lib/mapping/CMap.h"
+#include "../../lib/mapping/CMapService.h"
+#include "../../lib/mapObjects/CGTownInstance.h"
+#include "../../lib/networkPacks/PacksForClient.h"
+#include "../../lib/filesystem/ResourcePath.h"
+#include "../../lib/modding/CModHandler.h"
+
+class RegressionServer : public IGameServer
+{
+public:
+	CGameHandler * handler = nullptr;
+	void setState(EServerState) override {}
+	EServerState getState() const override { return EServerState::GAMEPLAY; }
+	bool isPlayerHost(const PlayerColor &) const override { return true; }
+	bool hasPlayerAt(PlayerColor, GameConnectionID) const override { return true; }
+	bool hasBothPlayersAtSameConnection(PlayerColor, PlayerColor) const override { return true; }
+	void applyPack(CPackForClient & pack) override { handler->gs->apply(pack); }
+	void sendPack(CPackForClient &, GameConnectionID) override {}
+};
+
+class DragonGrowthRegression
+{
+	static void require(bool condition, const std::string & message)
+	{
+		if(!condition)
+			throw std::runtime_error(message);
+	}
+
+public:
+	static void run(const std::string & mapName)
+	{
+		require(vstd::contains(LIBRARY->modh->getActiveMods(), std::string("dragon-citadel.endgame-rules")), "Endgame rules must be active");
+		CMapService maps;
+		auto header = maps.loadMapHeader(ResourcePath(mapName));
+		StartInfo start;
+		start.mapname = mapName;
+		start.mode = EStartMode::NEW_GAME;
+		start.difficulty = 0;
+		for(int i = 0; i < header->players.size(); ++i)
+		{
+			const auto & info = header->players[i];
+			if(!info.canHumanPlay && !info.canComputerPlay)
+				continue;
+			auto & player = start.playerInfos[PlayerColor(i)];
+			player.color = PlayerColor(i);
+			player.name = "Regression";
+			player.connectedPlayerIDs.insert(static_cast<PlayerConnectionID>(i));
+			player.castle = info.defaultCastle();
+			player.hero = info.defaultHero();
+		}
+		RegressionServer server;
+		CGameHandler handler(server);
+		server.handler = &handler;
+		Load::ProgressAccumulator progress;
+		handler.init(&start, progress);
+		CGTownInstance * town = nullptr;
+		for(const auto id : handler.gs->getMap().getAllTowns())
+		{
+			auto * candidate = handler.gs->getTown(id);
+			if(candidate->getFaction()->getJsonKey() == "dragon-citadel:dragonCitadel")
+				town = candidate;
+		}
+		require(town != nullptr, "Test map must contain a Dragon Citadel town");
+		const auto base = town->getTown()->creatures.at(7).at(0);
+		const auto upgraded = town->getTown()->creatures.at(7).at(1);
+		handler.buildStructure(town->id, BuildingID::CASTLE, true);
+		handler.buildStructure(town->id, BuildingID::GRAIL, true);
+		require(vstd::contains(town->creatures.at(7).second, base) && vstd::contains(town->creatures.at(7).second, upgraded), "Building the Grail must unlock both dragon forms");
+		for(const auto dragon : {base, upgraded})
+		{
+			town->creatures.at(7).second = {dragon};
+			town->creatures.at(7).first = 0;
+			handler.gs->day = 0;
+			// Exercise the real packet calculation and application, including its date change.
+			for(int day = 1; day <= 85; ++day)
+			{
+				if(day == 29)
+				{
+					const auto townID = town->id;
+					handler.save("Saves/Monthly-regression", PlayerColor::NEUTRAL);
+					auto resume = *handler.gs->getStartInfo();
+					resume.mapname = "Saves/Monthly-regression.vsgm1";
+					resume.mode = EStartMode::LOAD_GAME;
+					handler.load(resume);
+					town = handler.gs->getTown(townID);
+					require(handler.gs->day == 28 && town->creatures.at(7).first == 0, "Day-28 save/load must preserve the empty recruitment pool");
+					std::cout << "PASS save/load immediately before month boundary" << std::endl;
+				}
+				auto pack = handler.newTurnProcessor->generateNewTurnPack();
+				const auto previous = town->creatures.at(7).first;
+				const auto expected = pack.specialWeek == EWeekType::PLAGUE ? previous / 2 + 1 : previous + (day > 1 && day % 28 == 1 ? 1 : 0);
+				handler.gs->apply(pack);
+				const auto actual = town->creatures.at(7).first;
+				require(actual == expected, "Day " + std::to_string(day) + ": expected " + std::to_string(expected) + " recruitable dragons, got " + std::to_string(actual));
+				if(day == 1 || day % 7 == 1)
+					std::cout << "PASS " << dragon.toCreature()->getJsonKey() << " day=" << day << " recruitable=" << actual << std::endl;
+			}
+			for(const auto owner : {town->tempOwner, PlayerColor::NEUTRAL})
+			{
+				const auto originalOwner = town->tempOwner;
+				town->tempOwner = owner;
+				for(const auto week : {EWeekType::NORMAL, EWeekType::BONUS_GROWTH, EWeekType::DOUBLE_GROWTH, EWeekType::DEITYOFFIRE, EWeekType::PLAGUE})
+				{
+					for(const auto monthly : {false, true})
+					{
+						town->creatures.at(7).first = 6;
+						auto pool = handler.newTurnProcessor->generateTownGrowth(town, week, dragon, false, monthly, 15);
+						const auto expected = (week == EWeekType::PLAGUE ? 3 : 6) + (monthly ? 1 : 0);
+						require(pool.creatures.at(7).first == expected, "Special week or neutral owner changed monthly growth");
+					}
+				}
+				town->tempOwner = originalOwner;
+			}
+		}
+		town->creatures.at(7).second.clear();
+		town->creatures.at(7).first = 0;
+		auto unavailable = handler.newTurnProcessor->generateTownGrowth(town, EWeekType::NORMAL, base, false, true, 0);
+		require(unavailable.creatures.at(7).first == 0, "No growth is allowed before recruitment is unlocked");
+		town->creatures.at(7).second = {base, upgraded};
+		auto shared = handler.newTurnProcessor->generateTownGrowth(town, EWeekType::DOUBLE_GROWTH, upgraded, false, true, 15);
+		require(shared.creatures.at(7).first == 1, "Both dragon forms must share a single monthly recruit");
+		require(town->getGrowthInfo(7).totalGrowth() == 1, "Town growth display must show the monthly recruit");
+		std::cout << "PASS both dragons, 170 daily transitions, 40 special-week/owner cases, locked recruitment and shared pool" << std::endl;
+	}
+};
+
+int main(int argc, char ** argv)
+{
+	try
+	{
+		LIBRARY = new GameLibrary;
+		LIBRARY->initializeFilesystem(false);
+		LIBRARY->initializeLibrary();
+		DragonGrowthRegression::run(argc > 1 ? argv[1] : "MAPS/Smocza_Cytadela_AI_Bill_S.vmap");
+		return 0;
+	}
+	catch(const std::exception & error)
+	{
+		std::cerr << "FAIL: " << error.what() << std::endl;
+		return 1;
+	}
+}
