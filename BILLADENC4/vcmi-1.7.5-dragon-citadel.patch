+std::shared_ptr<SDLImageShared> SDLImageShared::grayscale() const
+{
+	if(upscalingInProgress)
+		throw std::runtime_error("Cannot convert an image that is still loading");
+	if(!surf)
+		return std::make_shared<SDLImageShared>(nullptr);
+
+	auto * converted = SDL_ConvertSurfaceFormat(surf, SDL_PIXELFORMAT_ARGB8888, 0);
+	if(!converted)
+		throw std::runtime_error(SDL_GetError());
+	CSDL_Ext::convertToGrayscale(converted, Rect(0, 0, converted->w, converted->h));
+	auto result = std::make_shared<SDLImageShared>(converted);
+	result->margins = margins;
+	result->fullSize = fullSize;
+	result->asyncUpscale = asyncUpscale;
+	SDL_FreeSurface(converted);
+	return result;
+}
