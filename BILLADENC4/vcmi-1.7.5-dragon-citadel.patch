+#include "../../client/StdInc.h"
+#include "../../lib/GameLibrary.h"
+#include "../../client/renderSDL/RenderHandler.h"
+#include "../../client/renderSDL/SDLImage.h"
+#include "../../client/renderSDL/SDL_Extensions.h"
+#include "../../client/render/ImageLocator.h"
+#include "../../lib/campaign/CampaignHandler.h"
+#include "../../lib/campaign/CampaignState.h"
+#include <SDL_surface.h>
+#include <SDL_image.h>
+
+void handleFatalError(const std::string & message, bool)
+{
+	throw std::runtime_error(message);
+}
+
+int main(int argc, char ** argv)
+{
+	try
+	{
+		LIBRARY = new GameLibrary;
+		LIBRARY->initializeFilesystem(false);
+		RenderHandler renderer;
+		for(const std::string name : {"dcUltimateDragon", "dcAbsoluteDragon", "dcRubyGolem"})
+		{
+			ImageLocator locator;
+			locator.image = ImagePath::builtin("dragon-citadel/creatures/" + name + "/battle/g02-f000");
+			locator.scalingFactor = 1;
+			locator.layer = EImageBlitMode::ONLY_BODY_HIDE_SELECTION;
+			auto original = renderer.loadScaledImage(locator);
+			locator.layer = EImageBlitMode::GRAYSCALE_BODY_HIDE_SELECTION;
+			auto stone = renderer.loadScaledImage(locator);
+			if(!original || !stone)
+				throw std::runtime_error("Missing test sprite: " + name);
+			original->exportBitmap("visual/" + name + "-original.png", nullptr);
+			stone->exportBitmap("visual/" + name + "-stone.png", nullptr);
+			auto * a = IMG_Load(("visual/" + name + "-original.png").c_str());
+			auto * b = IMG_Load(("visual/" + name + "-stone.png").c_str());
+			if(!a || !b || a->w != b->w || a->h != b->h)
+				throw std::runtime_error("Petrification changed image size");
+			int changed = 0;
+			int visible = 0;
+			for(int y = 0; y < a->h; ++y)
+				for(int x = 0; x < a->w; ++x)
+				{
+					ColorRGBA ca, cb;
+					SDL_GetRGBA(CSDL_Ext::getPixel(a, x, y), a->format, &ca.r, &ca.g, &ca.b, &ca.a);
+					SDL_GetRGBA(CSDL_Ext::getPixel(b, x, y), b->format, &cb.r, &cb.g, &cb.b, &cb.a);
+					if(ca.a != cb.a)
+						throw std::runtime_error("Petrification changed transparency");
+					if(cb.a)
+					{
+						++visible;
+						if(cb.r != cb.g || cb.g != cb.b)
+							throw std::runtime_error("Petrified sprite still contains colored pixels: " + name);
+						if(ca.r != cb.r || ca.g != cb.g || ca.b != cb.b)
+							++changed;
+					}
+				}
+			SDL_FreeSurface(a);
+			SDL_FreeSurface(b);
+			if(visible == 0 || changed == 0)
+				throw std::runtime_error("Petrification test must visibly change the creature");
+			std::cout << "PASS " << name << ": " << visible << " visible pixels, " << changed << " converted; dimensions and alpha unchanged" << std::endl;
+		}
+		LIBRARY->initializeLibrary();
+		auto campaign = CampaignHandler::getCampaign("MAPS/Smocza_Cytadela.vcmp");
+		std::vector<ImagePath> images{campaign->getRegions().getBackgroundName()};
+		for(int i = 0; i < 8; ++i)
+		{
+			images.push_back(campaign->getRegions().getAvailableName(CampaignScenarioID(i), i));
+			images.push_back(campaign->getRegions().getSelectedName(CampaignScenarioID(i), i));
+			images.push_back(campaign->getRegions().getConqueredName(CampaignScenarioID(i), i));
+		}
+		for(const auto & path : images)
+		{
+			ImageLocator locator;
+			locator.image = path;
+			locator.scalingFactor = 1;
+			if(!renderer.loadScaledImage(locator))
+				throw std::runtime_error("Campaign region graphics missing");
+		}
+		std::cout << "PASS all 25 campaign background/region graphics load" << std::endl;
+		return 0;
+	}
+	catch(const std::exception & error)
+	{
+		std::cerr << "FAIL: " << error.what() << std::endl;
+		return 1;
+	}
+}
